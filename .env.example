# ==============================================================================
# VERVE26 Environment Variables Template
# Copy this file to '.env.local' and fill in the values below.
# DO NOT commit '.env.local' to version control!
# ==============================================================================

# 1. SUPABASE CONFIGURATION (Frontend & Public API access)
# Find these in your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 2. SECURE BACKEND CONFIGURATION (DO NOT EXPOSE TO CLIENT)
# This key is required for Admin API routes and Database Seeding to bypass RLS.
# Find this in Supabase Dashboard -> Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. EMAIL DISPATCH CONFIGURATION (Resend)
# Required for sending QR tickets upon successful registration.
# Find this in your Resend Dashboard -> API Keys
RESEND_API_KEY="re_your-resend-api-key"
